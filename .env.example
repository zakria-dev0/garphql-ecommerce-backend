POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
# Host-side URL (from your machine, e.g. running etl/api outside Docker): port 5434.
# Inside docker-compose, services use postgres:5432 instead (see docker-compose.yml).
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5434/ecommerce

DATA_DIR=ecommerce_data
